# ───────── Supabase (Required for DB + File Storage) ─────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=certificate-studio

# ───────── Database (Supabase Postgres) ─────────
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres?sslmode=require
# Fallback individual params (used when DATABASE_URL is not set)
DB_USER=postgres
DB_HOST=db.your-project.supabase.co
DB_NAME=postgres
DB_PASSWORD=your-db-password
DB_PORT=5432

# ───────── Server ─────────
PORT=5000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:5000
CLIENT_BASE_URL=http://localhost:5173
CRON_SECRET=your-cron-secret

# ───────── Email (Nodemailer) ─────────
PURCHASE_EMAIL_SERVICE=gmail
PURCHASE_EMAIL_USER=your-email@gmail.com
PURCHASE_EMAIL_PASS=your-app-password
SKIP_EMAIL_DNS_CHECK=true

# ───────── Authentication ─────────
BCRYPT_SALT_ROUNDS=10

# ───────── Canva Integration (Optional) ─────────
CANVA_CLIENT_ID=your-canva-client-id
CANVA_CLIENT_SECRET=your-canva-client-secret
CANVA_REDIRECT_URI=http://localhost:5000/api/canva/callback
FRONTEND_URL=http://localhost:5173

# ───────── SSLCommerz (Optional - Bangladesh Payments) ─────────
# SSL_COMMERZ_STORE_ID=
# SSL_COMMERZ_STORE_PASSWORD=
# IS_LIVE=false

# ───────── Feature Flags ─────────
# ATTACHMENT_CLEANUP_MAX_AGE=2d

# ───────── Legacy Cloudinary (Only needed if running server.js) ─────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
